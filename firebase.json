{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "personal-haven-405b9",
          "appId": "1:748102487039:android:4099c0c52f33170471f5ca",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "personal-haven-405b9",
          "appId": "1:748102487039:ios:956d6655f17a65f071f5ca",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "personal-haven-405b9",
          "configurations": {
            "android": "1:748102487039:android:4099c0c52f33170471f5ca",
            "ios": "1:748102487039:ios:956d6655f17a65f071f5ca",
            "web": "1:748102487039:web:5d811ca1f21af3a571f5ca"
          }
        }
      }
    }
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Personal Haven",
        "supportEmail": "support@megnifylabs.com"
      }
    }
  }
}
